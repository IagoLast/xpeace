# OAuth 2.0 confidential Web App in the X Developer Console.
APP_URL=http://127.0.0.1:3000
X_CLIENT_ID=
X_CLIENT_SECRET=
# openssl rand -hex 32 (do not change after encrypting account tokens)
APP_SECRET=
# Neon Postgres, available through Vercel Marketplace
DATABASE_URL=
# Optional on Vercel with OIDC; required locally unless using vercel env pull
AI_GATEWAY_API_KEY=
# openssl rand -hex 32; Vercel sends this as Authorization: Bearer
CRON_SECRET=
# Optional: restrict this personal deployment to these X account IDs (comma-separated)
ALLOWED_X_USER_IDS=

# Stripe: use test credentials first; all values below are server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active recurring monthly, fixed-price, quantity-one price (price_...).
STRIPE_PRICE_ID=
# Optional bpc_...; otherwise configure Stripe's default customer portal.
STRIPE_PORTAL_CONFIGURATION_ID=
# Lite allowances per paid period; 200 X credits budget $1 at current X rates.
# New limits take effect on a subscription's next paid period.
BILLING_X_REQUESTS_LIMIT=2000
BILLING_X_CREDITS_LIMIT=200
BILLING_ANALYSES_LIMIT=100
